package host:interfaces@2.1.0;

interface logging {
  enum level {
    info,
    debug,
    error,
    warn
  }
  log: func(level: level, message: string);
}

interface kv-store {
  get: func(map-name: string, key: string) -> result<option<list<u8>>, string>;
  set: func(map-name: string, key: string, value: list<u8>) -> result<_, string>;
}

interface http-with-placeholders {
  record response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  send: func(url: string, method: string, headers: list<tuple<string, string>>, body: option<list<u8>>) -> result<response, string>;
}
